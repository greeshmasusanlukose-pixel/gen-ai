# ==============================================================================
# Kerala Accessibility Assistant - AI/LLM Service Configuration
# Member 3: AI Service Integration
# ==============================================================================

# Primary LLM Provider: Google Gemini
# Obtain key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Gemini model override (defaults to gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# Optional: Request timeout in seconds (defaults to 30.0)
AI_SERVICE_TIMEOUT_SECONDS=30.0

# Optional: Alternative OpenAI provider (if using OpenAI instead of Gemini)
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini

# Optional: Force offline mock fallback for local UI testing without API keys
# Set to 'true' or 'false'. (Defaults to true in dev if no keys are found).
AI_SERVICE_MOCK_FALLBACK=false

